{
  "manifest_version": 3,
  "name": "Reel Meeting Prompt",
  "version": "0.1.2",
  "description": "Offer to send a detected meeting link to Reel.",
  "permissions": ["alarms", "notifications", "storage"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://zoom.us/j/*",
    "https://*.zoom.us/j/*",
    "https://zoom.us/wc/*",
    "https://*.zoom.us/wc/*",
    "https://teams.microsoft.com/l/meetup-join/*",
    "https://teams.microsoft.com/meet/*",
    "https://teams.live.com/meet/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://zoom.us/j/*",
        "https://*.zoom.us/j/*",
        "https://zoom.us/wc/*",
        "https://*.zoom.us/wc/*",
        "https://teams.microsoft.com/l/meetup-join/*",
        "https://teams.microsoft.com/meet/*",
        "https://teams.live.com/meet/*"
      ],
      "js": ["organization.js", "parser.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js" },
  "commands": {
    "recorder-start-stop": {
      "description": "Open or stop Reel Recorder",
      "global": true
    },
    "recorder-pause-resume": {
      "description": "Pause or resume a Reel recording",
      "global": true
    },
    "recorder-cancel": {
      "description": "Cancel a Reel recording",
      "global": true
    }
  },
  "icons": { "128": "icon128.png" }
}
