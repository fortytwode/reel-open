# Temporary manual sign-in image; never changes the production worker entrypoint.
ARG BASE_IMAGE=reel-meeting-bot:local
FROM ${BASE_IMAGE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gnupg x11vnc novnc websockify \
    && curl -fsSL https://dl.google.com/linux/linux_signing_key.pub \
       | gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg \
    && echo 'deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main' \
       > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update && apt-get install -y --no-install-recommends google-chrome-stable \
    && rm -rf /var/lib/apt/lists/*
COPY google_session_setup.py google_auth.py /app/
USER pwuser
EXPOSE 8080
ENTRYPOINT ["tini", "--", "python", "/app/google_session_setup.py"]
