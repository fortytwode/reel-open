{
  "hosting": [
    {
      "target": "reel",
      "public": "web",
      "cleanUrls": true,
      "trailingSlash": false,
      "rewrites": [
        {
          "source": "/v/**",
          "destination": "/v.html"
        }
      ],
      "headers": [
        {
          "source": "/record",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/record.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=300"
            }
          ]
        },
        {
          "source": "/v/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            },
            {
              "key": "X-Robots-Tag",
              "value": "noindex"
            }
          ]
        }
      ]
    }
  ],
  "storage": [
    {
      "target": "main",
      "rules": ".reel/firebase/storage.rules"
    }
  ],
  "firestore": [
    {
      "database": "reel",
      "rules": ".reel/firebase/firestore.rules"
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
